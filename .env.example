# Only use short-lived AWS credentials from your own environment or OIDC in CI.
# These values are examples and are not valid credentials.
AWS_REGION=us-east-1
AWS_ACCOUNT_ID=123456789012
AWS_ROLE_ARN=arn:aws:iam::123456789012:role/replace-with-your-role
# Optional local OpenAI-compatible inference endpoint (for RAG and agent demos).
LLM_BASE_URL=http://127.0.0.1:8000/v1
LLM_MODEL=replace-with-local-model-name
